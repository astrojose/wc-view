{
  "name": "@astrojose/wc-view",
  "version": "0.1.1",
  "description": "Local Markdown review surface for agent workflows",
  "type": "module",
  "bin": {
    "wc-view": "dist/bin/wc-view.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "validate:workflow": "python3 .agents/workflows/workflow-contract/scripts/validate_workflow.py"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "marked": "^13.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "esbuild": "^0.23.0",
    "happy-dom": "^20.11.1",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
