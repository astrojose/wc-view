{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/doc/**",
              "components/review/**",
              "ui_kits/wc-view-review/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono|Playfair Display))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono, Playfair Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotatedBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|status|active|selectable|onSelect|children|key|ref|className|style|children)$/]",
        "message": "<AnnotatedBlock> doesn't accept that prop. Declared props: count, status, active, selectable, onSelect, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotatedBlock'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:unresolved|in_progress|resolved|orphaned)$/]",
        "message": "<AnnotatedBlock> status must be one of 'unresolved' | 'in_progress' | 'resolved' | 'orphaned'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotationItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|quote|comment|scope|status|key|ref|className|style|children)$/]",
        "message": "<AnnotationItem> doesn't accept that prop. Declared props: id, quote, comment, scope, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotationItem'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:unresolved|in_progress|resolved|orphaned)$/]",
        "message": "<AnnotationItem> status must be one of 'unresolved' | 'in_progress' | 'resolved' | 'orphaned'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotationPopover'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|anchorNote|value|status|onChange|onSave|onCancel|key|ref|className|style|children)$/]",
        "message": "<AnnotationPopover> doesn't accept that prop. Declared props: quote, anchorNote, value, status, onChange, onSave, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotationPopover'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:unresolved|in_progress|resolved|orphaned)$/]",
        "message": "<AnnotationPopover> status must be one of 'unresolved' | 'in_progress' | 'resolved' | 'orphaned'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|icon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|count|onRemove|tone|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, icon, count, onRemove, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent)$/]",
        "message": "<Chip> tone must be one of 'neutral' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|label|reservedHeight|key|ref|className|style|children)$/]",
        "message": "<CodeBlock> doesn't accept that prop. Declared props: code, label, reservedHeight."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|description|confirmLabel|onConfirm|onCancel|key|ref|className|style|children)$/]",
        "message": "<ConfirmDialog> doesn't accept that prop. Declared props: open, title, description, confirmLabel, onConfirm, onCancel."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocCanvas'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|children|key|ref|className|style|children)$/]",
        "message": "<DocCanvas> doesn't accept that prop. Declared props: title, meta, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloatingComposer'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onSubmit|noteCount|selection|queueOpen|onToggleQueue|queueIcon|children|key|ref|className|style|children)$/]",
        "message": "<FloatingComposer> doesn't accept that prop. Declared props: value, onChange, onSubmit, noteCount, selection, queueOpen, onToggleQueue, queueIcon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|active|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: label, icon, active, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShortcutRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:keys|label|key|ref|className|style|children)$/]",
        "message": "<ShortcutRow> doesn't accept that prop. Declared props: keys, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|children|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: status, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:unresolved|in_progress|resolved|orphaned)$/]",
        "message": "<StatusBadge> status must be one of 'unresolved' | 'in_progress' | 'resolved' | 'orphaned'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusRegion'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|tone|key|ref|className|style|children)$/]",
        "message": "<StatusRegion> doesn't accept that prop. Declared props: message, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusRegion'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|progress|success|warning|error)$/]",
        "message": "<StatusRegion> tone must be one of 'neutral' | 'progress' | 'success' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|onChange|lightIcon|darkIcon|key|ref|className|style|children)$/]",
        "message": "<ThemeToggle> doesn't accept that prop. Declared props: theme, onChange, lightIcon, darkIcon."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<ThemeToggle> theme must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|meta|expanded|onToggle|actions|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: message, meta, expanded, onToggle, actions."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
